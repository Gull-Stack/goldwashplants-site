<div class="calc-prose">
  <h2>How wash plant sizing works</h2>
  <p>A gold wash plant is rated by how many tons of material it can process per hour (TPH). The right size is whichever your feed equipment can keep fed - there's no point buying a 300 TPH plant if a single mini excavator can only feed 80. Two questions decide it: how much you want to process, and how you'll load the hopper.</p>
  <p>All of our plants share the same proven 95-98% recovery sluice, so stepping up in size buys you throughput, not better recovery. See the full <a href="/products/">model comparison</a> or read our guide to <a href="/blog/choosing-right-size-gold-wash-plant/">choosing the right size gold wash plant</a>.</p>
  <h2>Still not sure?</h2>
  <p>Every operation is different. Tell us your material type, volume and location and we'll size it for you - free, no obligation. Browse all <a href="/">gold wash plants for sale</a> or learn more about <a href="/placer-mining-equipment/">placer mining equipment</a>.</p>
</div>

<script>
  (function () {
    var MODELS = {
      50:  { name: "50 Ton Gold Wash Plant",  why: "Highly portable, sets up in under 30 minutes, and is our best seller for small claims and prospecting.", url: "/products/50-ton/" },
      100: { name: "100 Ton Gold Wash Plant", why: "A portable mid-range workhorse for growing operations that have outgrown a small plant.", url: "/products/100-ton/" },
      200: { name: "200 Ton Gold Wash Plant", why: "Our commercial best seller - serious throughput that's still movable around a site.", url: "/products/200-ton/" },
      300: { name: "300 Ton Gold Wash Plant", why: "Built for high-volume, large-scale alluvial production.", url: "/products/300-ton/" }
    };
    function pick() {
      var vol = parseInt(document.getElementById('calc-volume').value, 10);
      var feed = parseInt(document.getElementById('calc-feed').value, 10);
      if (isNaN(vol) || isNaN(feed)) { alert('Please answer the first two questions.'); return; }
      // Volume target; "not sure / testing" (0) defaults to the entry model.
      var byVol = vol === 0 ? 50 : vol;
      // You can't run a plant bigger than your feed equipment can load.
      var rec = Math.min(byVol, feed);
      if (rec < 50) rec = 50;
      var m = MODELS[rec];
      document.getElementById('rec-title').textContent = m.name;
      var why = m.why;
      if (feed < byVol) { why += " We capped the size at what your feed equipment can realistically load - a bigger plant would sit half-empty."; }
      document.getElementById('rec-why').textContent = why;
      document.getElementById('rec-details').setAttribute('href', m.url);
      document.getElementById('rec-fine').style.display = document.getElementById('calc-fine').checked ? 'block' : 'none';
      document.getElementById('calc-result').classList.add('show');
      document.getElementById('calc-result').scrollIntoView({ behavior: 'smooth', block: 'center' });
      if (window.gtag) { gtag('event', 'calculator_result', { event_category: 'engagement', event_label: m.name }); }
    }
    document.getElementById('calc-go').addEventListener('click', pick);
  })();
</script>
