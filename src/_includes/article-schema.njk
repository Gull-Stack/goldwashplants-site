{# Article + BreadcrumbList schema for /blog/* posts.
   Consumer front-matter (datePublished is required; dateModified defaults to it):
     datePublished: "2026-03-15"
     dateModified:  "2026-05-14"   (optional)
     image:         "/images/gold-wash-plant.jpg"  (optional, defaults to site OG image)
#}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ title | safe }}",
  "description": "{{ description }}",
  "datePublished": "{{ datePublished or '2026-03-02' }}",
  "dateModified": "{{ dateModified or datePublished or '2026-03-02' }}",
  "author": {
    "@type": "Organization",
    "name": "Gold Wash Plants",
    "url": "https://goldwashplants.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Gold Wash Plants",
    "logo": {
      "@type": "ImageObject",
      "url": "https://goldwashplants.com/images/dark-logo.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://goldwashplants.com{{ permalink or page.url }}"
  },
  "image": "https://goldwashplants.com{{ image or '/images/gold-wash-plant.jpg' }}"
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://goldwashplants.com/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://goldwashplants.com/blog/" },
    { "@type": "ListItem", "position": 3, "name": "{{ title | safe }}", "item": "https://goldwashplants.com{{ permalink or page.url }}" }
  ]
}
</script>
